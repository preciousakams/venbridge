      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Vendbridge (VendBridge)' name='federated.08wmvix1ubxtzi1cw0flq0anvfsc' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='August' caption='Months Parameter' datatype='integer' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='8'>
              <calculation class='tableau' formula='8' />
              <aliases>
                <alias key='6' value='June' />
                <alias key='7' value='July' />
                <alias key='8' value='August' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.08wmvix1ubxtzi1cw0flq0anvfsc'>
            <column caption='CM uninstalls' datatype='real' name='[CM install (copy)_1043146264059310108]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Calculation_1043146263974223886] = [Parameters].[Parameter 1]&#13;&#10;THEN [Uninstalls]&#13;&#10;END' />
            </column>
            <column caption='MoM% uninstalls-' datatype='real' name='[CM transactions (copy)_1043146264010014741 1 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF (SUM([CM install (copy)_1043146264059310108]) - SUM([PM install (copy)_1043146264059588637]))/ SUM([PM install (copy)_1043146264059588637]) &lt; 0&#13;&#10;THEN (SUM([CM install (copy)_1043146264059310108]) - SUM([PM install (copy)_1043146264059588637]))/ SUM([PM install (copy)_1043146264059588637])&#13;&#10;END' />
            </column>
            <column caption='MoM% uninstalls+' datatype='real' name='[CM transactions (copy)_1043146264010014741 1 2]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF (SUM([CM install (copy)_1043146264059310108]) - SUM([PM install (copy)_1043146264059588637]))/ SUM([PM install (copy)_1043146264059588637]) &gt; 0&#13;&#10;THEN (SUM([CM install (copy)_1043146264059310108]) - SUM([PM install (copy)_1043146264059588637]))/ SUM([PM install (copy)_1043146264059588637])&#13;&#10;END' />
            </column>
            <column aggregation='Sum' caption='Month' datatype='integer' name='[Calculation_1043146263974223886]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='MONTH([Date])' />
            </column>
            <column datatype='date' name='[Date]' role='dimension' type='ordinal' />
            <column caption='PM uninstalls' datatype='real' name='[PM install (copy)_1043146264059588637]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Calculation_1043146263974223886] = [Parameters].[Parameter 1] - 1&#13;&#10;THEN [Uninstalls] &#13;&#10;END' />
            </column>
            <column datatype='real' name='[Uninstalls]' role='measure' type='quantitative' />
            <column-instance column='[Date]' derivation='None' name='[none:Date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[CM install (copy)_1043146264059310108]' derivation='Sum' name='[sum:CM install (copy)_1043146264059310108:qk]' pivot='key' type='quantitative' />
