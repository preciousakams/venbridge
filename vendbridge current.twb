            <column caption='Select Ranking Measure leaderboard' datatype='real' name='[Select Ranking Measure (copy)_176766289958027265]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Rank Parameter (copy)_176766289957744640]&#13;&#10;WHEN 1 THEN SUM([Avg Time Spent per User (min)])&#13;&#10;WHEN 2 THEN SUM([Daily Active Users])&#13;&#10;WHEN 3 THEN SUM([Num_Transactions])&#13;&#10;WHEN 4 THEN SUM([Number of App Crashes])&#13;&#10;WHEN 5 THEN SUM([User Sign Ups])&#13;&#10;WHEN 6 THEN SUM([Total App Installs])&#13;&#10;WHEN 7 THEN SUM([Uninstalls])&#13;&#10;END' />
            </column>
