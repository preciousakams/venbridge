            <column caption='Rank Color' datatype='string' name='[Calculation_1068197540095725569]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF RANK([Select Ranking Measure (copy)_176766289958027265]) = 1&#13;&#10;THEN &apos;Gold&apos;&#13;&#10;ELSEIF RANK([Select Ranking Measure (copy)_176766289958027265]) = 2&#13;&#10;THEN &apos;Silver&apos;&#13;&#10;ELSEIF RANK([Select Ranking Measure (copy)_176766289958027265]) = 3&#13;&#10;THEN &apos;Bronze&apos;&#13;&#10;ELSE &apos;Newbie&apos;&#13;&#10;&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
