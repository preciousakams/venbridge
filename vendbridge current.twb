            <column caption='MoM% churn rate+' datatype='real' name='[CM avg duration (copy)_1043146264009465872 1 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([CM avg duration (copy)_1043146264009465872]- [CM avg duration (copy)_1043146264009465872 1]) / [CM avg duration (copy)_1043146264009465872 1] &gt; 0&#13;&#10;THEN ([CM avg duration (copy)_1043146264009465872]- [CM avg duration (copy)_1043146264009465872 1]) / [CM avg duration (copy)_1043146264009465872 1]&#13;&#10;END' />
